    "@vercel/speed-insights": "2.1.0",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "next-sanity": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
